{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cmakefmt dprint plugin configuration",
  "type": "object",
  "properties": {
    "cmakefmt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineWidth": { "type": "integer", "minimum": 1 },
        "indentWidth": { "type": "integer", "minimum": 1 },
        "useTabs": { "type": "boolean" },
        "newLineKind": { "enum": ["auto", "lf", "crlf"] },
        "commandCase": { "enum": ["lower", "upper", "unchanged"] },
        "keywordCase": { "enum": ["lower", "upper", "unchanged"] },
        "maxEmptyLines": { "type": "integer", "minimum": 0 },
        "maxLinesHwrap": { "type": "integer", "minimum": 0 },
        "maxHangingWrapPositionalArgs": { "type": "integer", "minimum": 0 },
        "maxHangingWrapGroups": { "type": "integer", "minimum": 0 },
        "maxRowsCmdline": { "type": "integer", "minimum": 0 },
        "requireValidLayout": { "type": "boolean" },
        "wrapAfterFirstArg": { "type": "boolean" },
        "continuationAlign": { "enum": ["same-indent", "under-first-value"] },
        "enableSort": { "type": "boolean" },
        "autosort": { "type": "boolean" },
        "preserveArgumentComments": { "type": "boolean" },
        "dangleParens": { "type": "boolean" },
        "dangleAlign": { "enum": ["prefix", "open", "close"] },
        "enableMarkup": { "type": "boolean" },
        "firstCommentIsLiteral": { "type": "boolean" }
      }
    }
  }
}
